#!/usr/bin/env bash
# opencode against the local gemini-web-api proxy.
#
# Default GEMINI_BACKEND=api: the proxy talks to Gemini over HTTP with the cookies
# the cookie-provider extension (extension-cookies/, autoloaded in an isolated Chromium)
# pushes. Chrome only has to be running with that profile -- no Gemini tab, so
# any number of ocweb terminals run in parallel, each on its own Gemini thread.
# GEMINI_BACKEND=chrome ocweb keeps the old behaviour (a fresh Gemini tab per launch).
#
# ocweb --selftest: instead of opencode, a live two-turn chat through the proxy
# that checks the second turn continued the first one's Gemini thread.
set -euo pipefail

usage() {
  cat <<'HELP'
ocweb — opencode contra el proxy local gemini-web-api (Gemini web con tu cuenta).

Uso:
  ocweb [argumentos de opencode...]   abre opencode en la carpeta actual
  ocweb --selftest                    en vez de opencode: chat de prueba de 2 turnos
                                      que comprueba que el 2º continúa el hilo del 1º
  ocweb --help | -h                   esta ayuda (opciones de opencode: opencode --help)

Qué hace: arranca el proxy en el puerto 8100 si no está ya en marcha, prepara el
navegador según el modo, espera a que esté listo y abre opencode. Varias terminales
comparten el mismo proxy, que se cierra cuando sale la última. La primera vez instala
opencode (brew o npm) y crea ~/.config/opencode/opencode.json con el proveedor
gemini-web; una configuración existente nunca se modifica.

Modos (GEMINI_BACKEND):
  api      (por defecto) peticiones HTTP directas a Gemini con las cookies que envía la
           extensión extension-cookies/, cargada sola en un Chromium aislado en segundo
           plano. Sin pestañas de Gemini; cada sesión de opencode tiene su propio hilo.
           La primera vez se abre Chromium para iniciar sesión en Google.
  chrome   la extensión clásica maneja una pestaña de gemini.google.com en Google Chrome
           (abre una pestaña limpia por lanzamiento; -c / --continue reutiliza la sesión).
  webapi   HTTP directo con las cookies del Chrome normal (pide acceso al Llavero).
  auto     chrome si hay una pestaña conectada, si no webapi.
  Un proxy ya en marcha no cambia de modo: ciérralo (lsof -ti tcp:8100 | xargs kill).

Modelos (modo api; en opencode: -m gemini-web/<modelo>):
  gemini-4-hydrogen   por defecto, "Ayuda en tu día a día"
  gemini-flash-lite   el más rápido, "Respuestas rápidas"
  gemini-pro          3.1 Pro, "Investigación detallada": lento (25–50 s) y a veces no responde
  gemini-argon        4 Argon, "Código y análisis": EXPERIMENTAL, a menudo no responde o
                      devuelve un rechazo genérico ("Soy un modelo de lenguaje...")
  La lista real de tu cuenta: curl -s localhost:8100/v1/models. La configuración de
  opencode se crea con esa lista la primera vez; para regenerarla, bórrala.

Variables de entorno:
  GEMINI_BACKEND        modo (ver arriba)                        [api]
  GEMINI_DEFAULT_MODEL  modelo cuando la petición no indica uno  [gemini-4-hydrogen]
  GEMINI_API_PORT       puerto del proxy                         [8100]
  CHROME_BIN            navegador  [api: ~/Applications/Chromium.app; chrome: Google Chrome]
  CHROME_PROFILE        perfil     [api: ~/.chromium-gemini-proxy; chrome: ~/.chrome-gemini-proxy]
  GEMINI_WEB_API_DIR    repo de gemini-web-api [el de este script, o ~/tools/gemini-web-api]
  GEMINI_PROXY_LOG      log del proxy                            [/tmp/gemini-web-proxy.log]
  SELFTEST_MODEL        modelo para --selftest                   [el primero de /v1/models]

Archivos (modo api):
  ~/.gemini-web-api/cookies.json    cookies enviadas por la extensión (0600)
  ~/.gemini-web-api/sessions.json   hilo de Gemini de cada sesión de opencode

Ejemplos:
  ocweb                                  opencode con Hydrogen
  ocweb -m gemini-web/gemini-flash-lite  opencode con el modelo rápido
  GEMINI_BACKEND=chrome ocweb            el modo de pestaña clásico
  ocweb --selftest                       comprobar que todo funciona
  curl -s localhost:8100/health          estado: modo, cookies, pestañas
HELP
}
# Before anything starts or installs: the help only prints.
for arg in "$@"; do
  case "$arg" in
    --help | -h) usage; exit 0 ;;
  esac
done

PROJECT_DIR="$(pwd)"
# The repo this script lives in (also through a symlink, e.g. ~/.local/bin/ocweb),
# else ~/tools/gemini-web-api (a copy outside the repo).
SELF="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
if [ -z "${GEMINI_WEB_API_DIR:-}" ] && [ -f "$(dirname "$SELF")/main.py" ]; then
  GEMINI_WEB_API_DIR="$(dirname "$SELF")"
fi
REPO_DIR="${GEMINI_WEB_API_DIR:-$HOME/tools/gemini-web-api}"
# The extension pushes to 8100 unless told otherwise (chrome.storage.local {port}).
PROXY_PORT="${GEMINI_API_PORT:-8100}"
LOG_FILE="${GEMINI_PROXY_LOG:-/tmp/gemini-web-proxy.log}"
# Used by wait_for's conditions (kept for custom ones).
COOKIES_FRESH_S=900

export GEMINI_BACKEND="${GEMINI_BACKEND:-api}"

# The browser and its isolated profile, per mode:
#   api    -> Chromium (the standard build in ~/Applications/Chromium.app, installed from
#             the official chromium-browser-snapshots), its own profile, and the
#             cookie-provider extension autoloaded with --load-extension: no "Load unpacked".
#   chrome -> Google Chrome with the DOM extension's profile, as before.
# CHROME_BIN / CHROME_PROFILE override either.
if [ "$GEMINI_BACKEND" = "chrome" ]; then
  CHROME_BIN="${CHROME_BIN:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}"
  CHROME_PROFILE="${CHROME_PROFILE:-$HOME/.chrome-gemini-proxy}"
else
  CHROME_BIN="${CHROME_BIN:-$HOME/Applications/Chromium.app/Contents/MacOS/Chromium}"
  CHROME_PROFILE="${CHROME_PROFILE:-$HOME/.chromium-gemini-proxy}"
fi
export PROXY_PORT COOKIES_FRESH_S
export GEMINI_API_PORT="$PROXY_PORT"

SELFTEST=0
ARGS=()
for arg in "$@"; do
  if [ "$arg" = "--selftest" ]; then SELFTEST=1; else ARGS+=("$arg"); fi
done
set -- ${ARGS[@]+"${ARGS[@]}"}
# opencode itself: installed from a package manager when missing (Homebrew first,
# else npm), never by piping a remote script into a shell.
if [ "$SELFTEST" -eq 0 ] && ! command -v opencode >/dev/null 2>&1; then
  echo "opencode no está instalado: instalándolo..."
  if command -v brew >/dev/null 2>&1; then
    brew install opencode
  elif command -v npm >/dev/null 2>&1; then
    npm install -g opencode-ai
  else
    echo "Error: no hay brew ni npm para instalar opencode (https://opencode.ai/docs/)."
    exit 1
  fi
  hash -r
  if ! command -v opencode >/dev/null 2>&1; then
    echo "Error: opencode se instaló pero no está en el PATH."
    exit 1
  fi
fi
export GEMINI_PROXY_LOG="$LOG_FILE"

# opencode's provider for this proxy (the block in the README). Written only when
# the user has no opencode config at all: an existing one is never edited.
OPENCODE_CONFIG_FILE="$HOME/.config/opencode/opencode.json"
ensure_opencode_config() {
  if [ -f "$OPENCODE_CONFIG_FILE" ]; then
    if ! grep -q '"gemini-web"' "$OPENCODE_CONFIG_FILE"; then
      echo "Aviso: $OPENCODE_CONFIG_FILE no tiene el proveedor \"gemini-web\"; añádelo"
      echo "       (bloque en $REPO_DIR/README.md, sección opencode) para usar este proxy."
    fi
    return 0
  fi
  echo "Creando $OPENCODE_CONFIG_FILE con el proveedor gemini-web (puerto $PROXY_PORT)..."
  mkdir -p "$(dirname "$OPENCODE_CONFIG_FILE")"
  # The models are the account's own, from the running proxy's /v1/models (the default
  # first), named by Google's description. gemini-carbon is Argon asked the way that
  # stalls, so it is left out. No proxy answer: Hydrogen and Flash-Lite.
  OUT="$OPENCODE_CONFIG_FILE" python3 - <<'PY'
import json, os, urllib.request

port = os.environ["PROXY_PORT"]
skip = {"gemini-carbon"}
models = {}
try:
    with urllib.request.urlopen(f"http://127.0.0.1:{port}/v1/models", timeout=40) as r:
        for m in json.loads(r.read().decode())["data"]:
            if m["id"] not in skip:
                models[m["id"]] = {"name": m.get("description") or m["id"], "tools": True}
except Exception:
    pass
if not models:
    models = {
        "gemini-4-hydrogen": {"name": "4 Hydrogen (Ayuda en tu día a día)", "tools": True},
        "gemini-flash-lite": {"name": "3.5 Flash-Lite (Respuestas rápidas)", "tools": True},
    }
config = {
    "$schema": "https://opencode.ai/config.json",
    "model": "gemini-web/" + next(iter(models)),
    "provider": {
        "gemini-web": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Gemini Web (local)",
            "options": {"baseURL": f"http://localhost:{port}/v1", "apiKey": "not-needed"},
            "models": models,
        }
    },
}
with open(os.environ["OUT"], "w", encoding="utf-8") as f:
    json.dump(config, f, ensure_ascii=False, indent=2)
    f.write("\n")
print("  modelos:", ", ".join(models), "| por defecto:", next(iter(models)))
PY
}

STARTED_PROXY=0
cleanup() {
  [ "$STARTED_PROXY" -eq 1 ] && [ -n "${PROXY_PID:-}" ] || return 0
  kill -0 "$PROXY_PID" 2>/dev/null || return 0
  # Other ocweb terminals share this proxy: leave it to the last one.
  if pgrep -x opencode >/dev/null 2>&1; then
    echo ""
    echo "Proxy de Gemini Web (PID $PROXY_PID) sigue activo: otras sesiones de opencode lo usan."
    return 0
  fi
  echo ""
  echo "Cerrando proxy local de Gemini Web (PID $PROXY_PID)..."
  kill "$PROXY_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# A /health field via python3 (no jq dependency); empty when the proxy doesn't answer.
health_field() {
  FIELD="$1" python3 - <<'PY' 2>/dev/null || true
import json, os, urllib.request
try:
    with urllib.request.urlopen(f"http://127.0.0.1:{os.environ['PROXY_PORT']}/health", timeout=1.0) as r:
        v = json.loads(r.read().decode()).get(os.environ["FIELD"])
        print("" if v is None else v)
except Exception:
    pass
PY
}

# Poll /health until a condition on it holds. $1: seconds, $2: python expression on `h`.
wait_for() {
  TIMEOUT="$1" COND="$2" python3 - <<'PY'
import json, os, time, urllib.request
deadline = time.time() + float(os.environ["TIMEOUT"])
fresh = float(os.environ["COOKIES_FRESH_S"])
while time.time() < deadline:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{os.environ['PROXY_PORT']}/health", timeout=1.0) as r:
            h = json.loads(r.read().decode())
            if eval(os.environ["COND"], {"h": h, "fresh": fresh}):
                raise SystemExit(0)
    except SystemExit:
        raise
    except Exception:
        pass
    time.sleep(0.3)
raise SystemExit(1)
PY
}

if ! lsof -iTCP:"$PROXY_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Arrancando servidor proxy en puerto $PROXY_PORT (GEMINI_BACKEND=$GEMINI_BACKEND)..."
  cd "$REPO_DIR"
  uv run --active python main.py > "$LOG_FILE" 2>&1 &
  PROXY_PID=$!
  STARTED_PROXY=1
  if ! wait_for 15 'True'; then
    echo "Error: el proxy no respondió en /health tras 15s (revisa $LOG_FILE)"
    exit 1
  fi
else
  RUNNING_MODE="$(health_field backend_mode)"
  if [ -n "$RUNNING_MODE" ] && [ "$RUNNING_MODE" != "$GEMINI_BACKEND" ]; then
    echo "Aviso: el proxy ya activo en el puerto $PROXY_PORT usa GEMINI_BACKEND=$RUNNING_MODE, no $GEMINI_BACKEND."
    echo "       Ciérralo (lsof -ti tcp:$PROXY_PORT | xargs kill) para arrancarlo en modo $GEMINI_BACKEND."
  fi
fi

start_chrome() {
  if [ ! -x "$CHROME_BIN" ]; then
    echo "Error: no se encontró el navegador en '$CHROME_BIN'."
    echo "       Chromium estándar: descarga chrome-mac.zip de"
    echo "       https://commondatastorage.googleapis.com/chromium-browser-snapshots/index.html?prefix=Mac_Arm/"
    echo "       y deja Chromium.app en ~/Applications, o define CHROME_BIN."
    exit 1
  fi
  "$CHROME_BIN" \
    --user-data-dir="$CHROME_PROFILE" \
    --use-mock-keychain \
    --no-first-run \
    --no-default-browser-check \
    "$@" >/dev/null 2>&1 &
}

# api mode autoloads the cookie-provider extension; --load-extension needs it unpacked on disk.
LOAD_EXT="--load-extension=$REPO_DIR/extension-cookies"

if [ "$GEMINI_BACKEND" = "chrome" ]; then
  # DOM backend: a clean Gemini tab per launch, unless -c / --continue resumes a session.
  IS_CONTINUE=0
  for arg in "$@"; do
    if [[ "$arg" == "-c" || "$arg" == "--continue" ]]; then
      IS_CONTINUE=1
      break
    fi
  done
  if [ "$IS_CONTINUE" -eq 0 ] || ! pgrep -f "user-data-dir=$CHROME_PROFILE" >/dev/null 2>&1; then
    echo "Abriendo pestaña limpia de Gemini en Chrome aislado..."
    start_chrome "https://gemini.google.com/app"
    if ! wait_for 20 'h.get("free_tabs", 0) > 0'; then
      echo "Aviso: ninguna pestaña libre conectada tras 20s; continuando de todas formas..."
    fi
  fi
else
  # api backend: the isolated Chromium only has to run with the extension autoloaded,
  # which keeps the cookies fresh. No window: it stays in the background.
  if ! pgrep -f "user-data-dir=$CHROME_PROFILE" >/dev/null 2>&1; then
    echo "Arrancando Chromium aislado en segundo plano (proveedor de cookies)..."
    start_chrome "$LOAD_EXT" --no-startup-window
  fi
  # A push to THIS proxy, not just a recent cookies.json: Chromium may have rotated the
  # session while no proxy was running, which leaves the stored jar invalid. The
  # extension feeds a (re)started proxy within a minute.
  FRESH='h.get("cookies_pushed_since_start")'
  if ! wait_for 75 "$FRESH"; then
    # First run (or signed out): the extension is already loaded, so only sign-in is left.
    echo "No llegan cookies de la extensión. Abriendo Chromium para iniciar sesión (una sola vez):"
    echo "  Inicia sesión en Google en esa ventana. La extensión ya está cargada."
    echo "Esperando hasta 5 minutos a la primera subida de cookies..."
    start_chrome "$LOAD_EXT" "https://accounts.google.com/" >/dev/null 2>&1
    if ! wait_for 300 "$FRESH"; then
      echo "Aviso: sin cookies recientes de la extensión tras 5 minutos (revisa $LOG_FILE); continuando de todas formas..."
    fi
  fi
fi

if [ "$SELFTEST" -eq 1 ]; then
  cd "$REPO_DIR"
  GEMINI_API_BASE="http://127.0.0.1:$PROXY_PORT" PYTHONPATH=. uv run --active python tools/api_selftest.py
  exit $?
fi

ensure_opencode_config
cd "$PROJECT_DIR"
opencode "$@"
