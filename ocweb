#!/usr/bin/env bash
# opencode against the local gemini-web-api proxy.
#
# Default GEMINI_BACKEND=api: the proxy talks to Gemini over HTTP with the cookies
# the cookie-provider extension (extension-cookies/, loaded once in $CHROME_PROFILE)
# pushes. Chrome only has to be running with that profile -- no Gemini tab, so
# any number of ocweb terminals run in parallel, each on its own Gemini thread.
# GEMINI_BACKEND=chrome ocweb keeps the old behaviour (a fresh Gemini tab per launch).
#
# ocweb --selftest: instead of opencode, a live two-turn chat through the proxy
# that checks the second turn continued the first one's Gemini thread.
set -euo pipefail

PROJECT_DIR="$(pwd)"
# The repo this script lives in (also through a symlink, e.g. ~/.local/bin/ocweb),
# else ~/tools/gemini-web-api (a copy outside the repo).
SELF="$(python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
if [ -z "${GEMINI_WEB_API_DIR:-}" ] && [ -f "$(dirname "$SELF")/main.py" ]; then
  GEMINI_WEB_API_DIR="$(dirname "$SELF")"
fi
REPO_DIR="${GEMINI_WEB_API_DIR:-$HOME/tools/gemini-web-api}"
CHROME_PROFILE="$HOME/.chrome-gemini-proxy"
# The browser for the isolated cookie profile. Chromium (here: Chrome for Testing,
# installed by `npx @puppeteer/browsers install chrome`) runs in its own profile and
# autoloads the extension from the command line with --load-extension, so there is no
# "Load unpacked" step. Point CHROME_BIN at any Chromium/Chrome binary to override.
# Newest Chrome for Testing in the puppeteer cache (glob, highest version last).
_cft_matches=("$HOME"/.cache/puppeteer/chrome/*/chrome-mac-*/'Google Chrome for Testing.app'/Contents/MacOS/'Google Chrome for Testing')
_cft="${_cft_matches[${#_cft_matches[@]}-1]}"
[ -x "$_cft" ] || _cft="/Applications/Chromium.app/Contents/MacOS/Chromium"
CHROME_BIN="${CHROME_BIN:-$_cft}"
# The extension pushes to 8100 unless told otherwise (chrome.storage.local {port}).
PROXY_PORT="${GEMINI_API_PORT:-8100}"
LOG_FILE="${GEMINI_PROXY_LOG:-/tmp/gemini-web-proxy.log}"
# The extension pushes on start and every 8 minutes: older than this means it isn't running.
COOKIES_FRESH_S=900

export GEMINI_BACKEND="${GEMINI_BACKEND:-api}"
export PROXY_PORT COOKIES_FRESH_S
export GEMINI_API_PORT="$PROXY_PORT"

SELFTEST=0
ARGS=()
for arg in "$@"; do
  if [ "$arg" = "--selftest" ]; then SELFTEST=1; else ARGS+=("$arg"); fi
done
set -- ${ARGS[@]+"${ARGS[@]}"}
if [ "$SELFTEST" -eq 0 ] && ! command -v opencode >/dev/null 2>&1; then
  echo "Error: opencode no está instalado (o no está en el PATH). Prueba: ocweb --selftest"
  exit 1
fi
export GEMINI_PROXY_LOG="$LOG_FILE"

STARTED_PROXY=0
cleanup() {
  [ "$STARTED_PROXY" -eq 1 ] && [ -n "${PROXY_PID:-}" ] || return 0
  kill -0 "$PROXY_PID" 2>/dev/null || return 0
  # Other ocweb terminals share this proxy: leave it to the last one.
  if pgrep -x opencode >/dev/null 2>&1; then
    echo ""
    echo "Proxy de Gemini Web (PID $PROXY_PID) sigue activo: otras sesiones de opencode lo usan."
    return 0
  fi
  echo ""
  echo "Cerrando proxy local de Gemini Web (PID $PROXY_PID)..."
  kill "$PROXY_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# A /health field via python3 (no jq dependency); empty when the proxy doesn't answer.
health_field() {
  FIELD="$1" python3 - <<'PY' 2>/dev/null || true
import json, os, urllib.request
try:
    with urllib.request.urlopen(f"http://127.0.0.1:{os.environ['PROXY_PORT']}/health", timeout=1.0) as r:
        v = json.loads(r.read().decode()).get(os.environ["FIELD"])
        print("" if v is None else v)
except Exception:
    pass
PY
}

# Poll /health until a condition on it holds. $1: seconds, $2: python expression on `h`.
wait_for() {
  TIMEOUT="$1" COND="$2" python3 - <<'PY'
import json, os, time, urllib.request
deadline = time.time() + float(os.environ["TIMEOUT"])
fresh = float(os.environ["COOKIES_FRESH_S"])
while time.time() < deadline:
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{os.environ['PROXY_PORT']}/health", timeout=1.0) as r:
            h = json.loads(r.read().decode())
            if eval(os.environ["COND"], {"h": h, "fresh": fresh}):
                raise SystemExit(0)
    except SystemExit:
        raise
    except Exception:
        pass
    time.sleep(0.3)
raise SystemExit(1)
PY
}

if ! lsof -iTCP:"$PROXY_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "Arrancando servidor proxy en puerto $PROXY_PORT (GEMINI_BACKEND=$GEMINI_BACKEND)..."
  cd "$REPO_DIR"
  uv run --active python main.py > "$LOG_FILE" 2>&1 &
  PROXY_PID=$!
  STARTED_PROXY=1
  if ! wait_for 15 'True'; then
    echo "Error: el proxy no respondió en /health tras 15s (revisa $LOG_FILE)"
    exit 1
  fi
else
  RUNNING_MODE="$(health_field backend_mode)"
  if [ -n "$RUNNING_MODE" ] && [ "$RUNNING_MODE" != "$GEMINI_BACKEND" ]; then
    echo "Aviso: el proxy ya activo en el puerto $PROXY_PORT usa GEMINI_BACKEND=$RUNNING_MODE, no $GEMINI_BACKEND."
    echo "       Ciérralo (lsof -ti tcp:$PROXY_PORT | xargs kill) para arrancarlo en modo $GEMINI_BACKEND."
  fi
fi

start_chrome() {
  if [ ! -x "$CHROME_BIN" ]; then
    echo "Error: no se encontró Chromium en '$CHROME_BIN'."
    echo "       Instálalo con: npx @puppeteer/browsers install chrome@stable"
    echo "       (o 'brew install --cask chromium'), o define CHROME_BIN."
    exit 1
  fi
  "$CHROME_BIN" \
    --user-data-dir="$CHROME_PROFILE" \
    --use-mock-keychain \
    --no-first-run \
    --no-default-browser-check \
    "$@" >/dev/null 2>&1 &
}

# api mode autoloads the cookie-provider extension; --load-extension needs it unpacked on disk.
LOAD_EXT="--load-extension=$REPO_DIR/extension-cookies"

if [ "$GEMINI_BACKEND" = "chrome" ]; then
  # DOM backend: a clean Gemini tab per launch, unless -c / --continue resumes a session.
  IS_CONTINUE=0
  for arg in "$@"; do
    if [[ "$arg" == "-c" || "$arg" == "--continue" ]]; then
      IS_CONTINUE=1
      break
    fi
  done
  if [ "$IS_CONTINUE" -eq 0 ] || ! pgrep -f "chrome-gemini-proxy" >/dev/null 2>&1; then
    echo "Abriendo pestaña limpia de Gemini en Chrome aislado..."
    start_chrome "https://gemini.google.com/app"
    if ! wait_for 20 'h.get("free_tabs", 0) > 0'; then
      echo "Aviso: ninguna pestaña libre conectada tras 20s; continuando de todas formas..."
    fi
  fi
else
  # api backend: the isolated Chromium only has to run with the extension autoloaded,
  # which keeps the cookies fresh. No window: it stays in the background.
  if ! pgrep -f "user-data-dir=$CHROME_PROFILE" >/dev/null 2>&1; then
    echo "Arrancando Chromium aislado en segundo plano (proveedor de cookies)..."
    start_chrome "$LOAD_EXT" --no-startup-window
  fi
  FRESH='h.get("cookies_pushed_s_ago") is not None and h["cookies_pushed_s_ago"] < fresh'
  if ! wait_for 20 "$FRESH"; then
    # First run (or signed out): the extension is already loaded, so only sign-in is left.
    echo "No llegan cookies de la extensión. Abriendo Chromium para iniciar sesión (una sola vez):"
    echo "  Inicia sesión en Google en esa ventana. La extensión ya está cargada."
    echo "Esperando hasta 5 minutos a la primera subida de cookies..."
    start_chrome "$LOAD_EXT" "https://accounts.google.com/" >/dev/null 2>&1
    if ! wait_for 300 "$FRESH"; then
      echo "Aviso: sin cookies recientes de la extensión tras 5 minutos (revisa $LOG_FILE); continuando de todas formas..."
    fi
  fi
fi

if [ "$SELFTEST" -eq 1 ]; then
  cd "$REPO_DIR"
  GEMINI_API_BASE="http://127.0.0.1:$PROXY_PORT" PYTHONPATH=. uv run --active python tools/api_selftest.py
  exit $?
fi

cd "$PROJECT_DIR"
opencode "$@"
