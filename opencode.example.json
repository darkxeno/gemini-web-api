{
  "$schema": "https://opencode.ai/config.json",
  "model": "gemini-web/gemini-4-hydrogen",
  "small_model": "gemini-web/gemini-flash-lite",
  "provider": {
    "gemini-web": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Gemini Web (local)",
      "options": { "baseURL": "http://localhost:8100/v1", "apiKey": "not-needed" },
      "models": {
        "gemini-4-hydrogen": { "name": "4 Hydrogen (Ayuda en tu día a día)", "tools": true },
        "gemini-flash-lite": { "name": "3.5 Flash-Lite (Respuestas rápidas)", "tools": true },
        "gemini-pro": { "name": "3.1 Pro (Investigación detallada)", "tools": true },
        "gemini-argon": { "name": "4 Argon (Código y análisis) — experimental: a veces no responde", "tools": true }
      }
    }
  }
}
